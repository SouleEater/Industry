# HTTPS для «Индустрии». Домен берётся из переменной DOMAIN (см. docker-compose.yml).
# Caddy сам получает и продлевает сертификат Let's Encrypt; порты 80 и 443 должны быть открыты.
{$DOMAIN} {
	# flush_interval -1: события (SSE) уходят игрокам сразу, без буферизации
	reverse_proxy app:8080 {
		flush_interval -1
	}
	# Сжатие делает само приложение, здесь только заголовки безопасности поверх его собственных.
	header -Server
}
