# Скопируйте в .env (файл .env в git не попадает) и заполните.

# Домен, на который указывает A-запись вашего сервера (без https://)
DOMAIN=industry.example.com

# Секрет для CSRF-токенов, не короче 32 символов. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Кто может зарегистрироваться:
#   open   — любой желающий
#   invite — только с кодом приглашения (рекомендуется для закрытой компании)
#   closed — регистрация выключена (уже созданные пользователи входят)
REGISTRATION=invite
INVITE_CODE=

# Предел числа пользователей
MAX_USERS=500

# ---- дополнительно (значения по умолчанию подходят) ----
# SESSION_DAYS=14           срок жизни входа
# MAX_TABLES_PER_USER=10    сколько столов одновременно может вести один игрок
